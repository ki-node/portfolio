{
  "name": "ki-node-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "npm run lint:ts && npm run lint:css",
    "lint:ts": "eslint . --max-warnings=0",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.css\" --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && npm run build:embedded && playwright test",
    "test:e2e:ci": "playwright test",
    "build": "npm run typecheck && vite build && npm run budget",
    "build:embedded": "npm run typecheck && vite build --mode embedded && npm run budget:embedded",
    "budget": "node scripts/check-bundle-size.mjs",
    "budget:embedded": "node scripts/check-bundle-size.mjs dist-embedded",
    "test:builds": "node scripts/check-build-output.mjs",
    "lighthouse": "node scripts/run-lighthouse.mjs",
    "check": "npm run format:check && npm run lint && npm run test && npm run build && npm run build:embedded && npm run test:builds",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^4.1.10",
    "chrome-launcher": "^1.2.2",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.9",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource/dm-mono": "^5.2.7"
  }
}
